{
  "version": 1,
  "enabled": true,
  "provider": "openrouter",
  "model": "qwen/qwen3-coder-next",
  "level": "standard",
  "mode": "block",
  "events": [
    "pre-push"
  ],
  "branches": [
    "main",
    "master"
  ],
  "remotes": [
    "*"
  ],
  "exclude": [],
  "maxContextBytes": 100000,
  "timeoutSeconds": 180,
  "receiptHours": 24,
  "maxModelCalls": 20,
  "maxOutputTokens": 4096,
  "allowPaid": true,
  "agentMaxTurns": 8,
  "toolResultBytes": 16000,
  "backgroundPreparation": true,
  "preparationDebounceMs": 1500,
  "models": {
    "small": {
      "provider": "openrouter",
      "model": "qwen/qwen3-coder-next"
    },
    "medium": {
      "provider": "openrouter",
      "model": "qwen/qwen3-coder-next"
    },
    "large": {
      "provider": "openrouter",
      "model": "qwen/qwen3-coder"
    }
  },
  "routing": {
    "smallMaxLines": 80,
    "smallMaxFiles": 3,
    "largeMinLines": 400,
    "largeMinFiles": 12,
    "riskPatterns": [
      "auth",
      "permission",
      "migration",
      "billing",
      "payment",
      "crypto",
      "security",
      "terraform"
    ]
  }
}
